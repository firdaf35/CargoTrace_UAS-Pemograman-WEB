APP_NAME=App
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log

# Delay rule: a shipment is flagged DELAYED when (ETA - expected arrival) >= this many hours
DELAY_THRESHOLD_HOURS=12
DELAY_LOW_MAX_HOURS=6
DELAY_MEDIUM_MAX_HOURS=24

# External APIs (put real keys only in .env, never in git)
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT="MyApp/1.0 (your-email@example.com)"
WEATHER_BASE_URL=https://api.open-meteo.com/v1
WEATHER_API_KEY=
OPENWEATHER_API_KEY=
CURRENCY_BASE_URL=https://api.frankfurter.dev/v1
EXTERNAL_API_TIMEOUT=5